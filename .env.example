# Copy this file to .env before deploying and replace every development value.
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
WEB_PORT=8080

# Browser API base URL. Keep /api for the bundled Nginx reverse proxy,
# or set an absolute URL such as https://api.example.com/api.
API_URL=/api

# Needed only when the browser talks directly to a separately hosted API.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
